{
  "name": "MindMap",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Name of the mind map"
    },
    "description": {
      "type": "string",
      "description": "Brief description"
    },
    "notes": {
      "type": "string",
      "description": "Free-form notes attached to the mind map"
    },
    "userId": {
      "type": "string",
      "description": "ID of the user who owns this mind map"
    }
  },
  "required": [
    "title",
    "userId"
  ]
}